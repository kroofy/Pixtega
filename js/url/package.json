{
  "name": "@pixtega/url",
  "version": "0.1.0",
  "description": "URL builders for Pixtega, the on-demand image derivation service. Re-exports the pixtega package: pixtegaUrl, pixtegaSrcSet, pixtegaPicture.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "tsc --noEmit && node --experimental-strip-types --test"
  },
  "engines": {
    "node": ">=22.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kroofy/Pixtega.git",
    "directory": "js/url"
  },
  "homepage": "https://pixtega.com",
  "bugs": {
    "url": "https://github.com/kroofy/Pixtega/issues"
  },
  "keywords": [
    "pixtega",
    "image",
    "resize",
    "srcset",
    "picture",
    "webp",
    "avif",
    "url"
  ],
  "dependencies": {
    "pixtega": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
