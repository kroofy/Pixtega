{
  "name": "@pixtega/url",
  "version": "0.1.0",
  "description": "URL builders for Pixtega, the on-demand image derivation service. Re-exports the pixtega package: pixtegaUrl, pixtegaSrcSet, pixtegaPicture.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "prepack": "npm run build",
    "test": "npm run build && node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kroofy/Pixtega.git",
    "directory": "js/url"
  },
  "homepage": "https://pixtega.com",
  "bugs": {
    "url": "https://github.com/kroofy/Pixtega/issues"
  },
  "keywords": [
    "pixtega",
    "image",
    "resize",
    "srcset",
    "picture",
    "webp",
    "avif",
    "url"
  ],
  "dependencies": {
    "pixtega": "^0.1.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
