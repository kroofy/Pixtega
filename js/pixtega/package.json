{
  "name": "pixtega",
  "version": "0.1.0",
  "description": "URL builders for Pixtega, the on-demand image derivation service. Pure string helpers: pixtegaUrl, pixtegaSrcSet, pixtegaPicture.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --sourcemap --clean && tsc -p tsconfig.build.json && cp dist/index.d.ts dist/index.d.cts",
    "prepack": "npm run build",
    "test": "npm run build && node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kroofy/Pixtega.git",
    "directory": "js/pixtega"
  },
  "homepage": "https://pixtega.com",
  "bugs": {
    "url": "https://github.com/kroofy/Pixtega/issues"
  },
  "keywords": [
    "pixtega",
    "image",
    "resize",
    "srcset",
    "picture",
    "webp",
    "avif",
    "url"
  ],
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
